            {
              "kind": "includes",
              "value": "待办",
              "label": "待办段"
            },
            {
              "kind": "includes",
              "value": "回滚",
              "label": "回滚步骤"
            },
            {
              "kind": "notIncludes",
              "value": "欢迎",
              "label": "没有寒暄式长背景"
            }
          ],
          "semantic": [
            "结构符合结论/待办格式",
            "数据库变更确实写了回滚步骤",
            "没有编造历史未提供的信息"
          ],
          "boundaryFailures": [
